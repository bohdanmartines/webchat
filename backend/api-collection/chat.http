@baseUrl = http://localhost:9000

### Create chat
POST {{baseUrl}}/api/chat
Content-Type: application/json
Authorization: Bearer place_token_here

{
  "name": "Test Chat 1"
}

### Get chats for the current user
GET {{baseUrl}}/api/chat
Authorization: Bearer place_token_here

### Get chat details by ID
GET {{baseUrl}}/api/chat/1
Authorization: Bearer place_token_here

### Add user to a chat
POST {{baseUrl}}/api/chat/1/user
Authorization: Bearer place_token_here
Content-Type: application/json

{
  "username": "user3"
}

### Remove user from the chat
DELETE {{baseUrl}}/api/chat/1/user
Authorization: Bearer place_token_here
Content-Type: application/json

{
  "username": "user3"
}
